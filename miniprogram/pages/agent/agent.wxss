.page{padding-bottom:70rpx}.title{font-size:48rpx}.toggle-row switch{transform:scale(.8);transform-origin:right center}.picker{display:flex;justify-content:space-between}.textarea{font-size:25rpx}.input{font-size:25rpx}
.avatar-options{display:flex;gap:10rpx;flex-wrap:wrap}.avatar-option{flex:1;min-width:80rpx;padding:15rpx 8rpx;border:1rpx solid #e5ebdd;border-radius:18rpx;background:#fbfcf7;color:#839577}.avatar-option.selected{background:#edf5e5;border-color:#8ca77c}.avatar-emoji{display:block;font-size:42rpx;line-height:1.5}.avatar-label{display:block;font-size:20rpx;font-weight:400;margin-top:3rpx}
