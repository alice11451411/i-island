.match-item .section-title{font-size:29rpx;margin-bottom:3rpx}.match-item .tag-list{margin-bottom:0;margin-left:104rpx}.edit-button{margin-top:28rpx}.delete-item{color:#ad786b}.chat-page{padding:0 25rpx;height:calc(100vh - env(safe-area-inset-bottom));display:flex;flex-direction:column}.chat-head{display:flex;justify-content:space-between;align-items:center;padding:15rpx 0 23rpx;gap:12rpx;border-bottom:1rpx solid #e4ebdf}.chat-name{text-align:center;font-size:30rpx;font-weight:600;flex:1}.chat-name .small{font-weight:400;font-size:21rpx}.back{font-size:25rpx}.chat-demo{color:#ac946e;background:#f6efe1;text-align:center;padding:9rpx 13rpx;font-size:20rpx;border-radius:10rpx;margin:15rpx 0}.message-scroll{flex:1;height:0;min-height:200rpx;padding:15rpx 0}.chat-empty{padding-top:70rpx;line-height:2}.message{display:flex;flex-direction:column;align-items:flex-start;margin:24rpx 0;padding-right:75rpx}.message.mine{align-items:flex-end;padding-right:0;padding-left:75rpx}.message-text{max-width:100%;background:#fff;border:1rpx solid #e9eee3;border-radius:4rpx 23rpx 23rpx 23rpx;padding:20rpx 25rpx;line-height:1.8;font-size:27rpx}.mine .message-text{background:#e5eeda;border-color:#e0e9d7;border-radius:23rpx 4rpx 23rpx 23rpx}.message-time{font-size:19rpx;color:#9ba992;margin-top:6rpx}.composer{padding:15rpx 0 calc(22rpx + env(safe-area-inset-bottom));background:#f7f8f2;border-top:1rpx solid #e5ebde}.composer-tools{display:flex;justify-content:space-between;padding:0 5rpx 8rpx}.composer-tools .link{font-size:23rpx;font-weight:400}.composer-row{display:flex;gap:15rpx;align-items:center}.draft{flex:1;background:#fff;height:84rpx}.send{font-size:25rpx;padding:22rpx 27rpx;height:84rpx}.suggestions{padding-bottom:15rpx}.suggestion{font-size:23rpx;color:#6d8164;background:#edf3e5;border:1rpx solid #dce7d1;border-radius:15rpx;padding:13rpx 19rpx;margin-top:12rpx}.scroll-spacer{height:10rpx}.chat-page>.error{margin:10rpx 0;padding:12rpx 20rpx;font-size:23rpx}.chat-page>.error button{font-size:22rpx;padding:10rpx;margin-top:8rpx}