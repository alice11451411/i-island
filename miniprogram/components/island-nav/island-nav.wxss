.nav{position:fixed;bottom:0;left:0;right:0;display:flex;background:rgba(255,255,255,.97);border-top:1rpx solid #e9eee5;padding:13rpx 28rpx calc(17rpx + env(safe-area-inset-bottom));z-index:10;box-shadow:0 -8rpx 28rpx rgba(48,64,46,.035)}.item{flex:1;display:flex;align-items:center;flex-direction:column;font-size:21rpx;color:#9ba795;gap:2rpx;position:relative;min-height:63rpx}.item.active{color:#466d4d;font-weight:600}.item.active::before{content:"";position:absolute;top:-13rpx;width:24rpx;height:4rpx;background:#8ca97c;border-radius:4rpx}.icon{font-size:37rpx;font-weight:500;line-height:1.2}
