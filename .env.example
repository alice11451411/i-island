# 本地演示使用虚构用户；真实微信用户请设为 false 并配置服务端凭据。
DEMO_MODE=true
HOST=127.0.0.1
PORT=3210
# 可留空，默认使用项目内 data/island.sqlite
# DB_PATH=E:\i-island\data\island.sqlite
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# rules无需模型配置；model显式配置缺失、请求失败或输出越界将报错，不降级。
AI_MODE=rules
# 完整兼容 chat/completions 的接口地址；密钥仅服务端读取。
MODEL_API_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_TIMEOUT_MS=15000
# 模型只返回授权资料的索引和固定模板计划，最终文案由服务端验证后渲染。
# 模型模式需要单独指定质检模型；默认沿用上方地址和密钥，可单独覆盖。
REVIEW_MODEL_API_URL=
REVIEW_MODEL_API_KEY=
REVIEW_MODEL_NAME=
REVIEW_MODEL_TIMEOUT_MS=5000
# 平台生产内容审核仍需单独接入。
